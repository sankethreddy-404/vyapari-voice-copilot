# Copy this file to .env and paste the API key created in the Gnani dashboard.
# Never commit or share your real key.
GNANI_API_KEY=replace_with_your_gnani_api_key

# Current official Gnani Speech API endpoints.
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# Prisma v3.0 gives Indic auto-detection and code-mixed output.
# The backend automatically falls back to Prisma v2.5 + Telugu if v3.0 is unavailable.
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto
GNANI_STT_FORMAT=codemix
GNANI_STT_FALLBACK_MODEL=prisma-v2.5
GNANI_STT_FALLBACK_LANGUAGE=te-IN

# Timbre v2.5 voices from Gnani's official voice catalog.
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE_TE=Suhana
GNANI_TTS_VOICE_EN=Kaveri
GNANI_TTS_VOICE_HINGLISH=Poorvi
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_SPEED=1.0

APP_ADDR=:8080
DATA_FILE=data/store.json
MAX_AUDIO_UPLOAD_BYTES=12582912
EXTERNAL_TIMEOUT_SECONDS=60
